  "episodes": [
    {
      "id": "f16c2339-c2e9-4c11-a6d7-3d639563c013",
      "title": "JMS \uC815\uBA85\uC11D\uC758 \uBC94\uC8C4\uB97C \uC740\uD3D0\uD55C \uC5D8\uB9AC\uD2B8 \uAD8C\uB825 \uCE74\uB974\uD154\uC758 \uC2E4\uCCB4",
      "description": "\uC815\uBA85\uC11D\uACFC \uC81C\uC774\uC5E0\uC5D0\uC2A4\uC758 \uB054\uCC0D\uD55C \uBC94\uC8C4 \uC81C\uAD6D\uC774 \uC774\uC2ED\uC5EC \uB144\uAC04 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uC558\uB358 \uC9C4\uC9DC \uC774\uC720, \uADF8 \uC369\uC5B4\uBE60\uC9C4 \uC870\uC9C1\uC801 \uCE74\uB974\uD154\uC758 \uC2E4\uCCB4\uB97C \uB0B1\uB0B1\uC774 \uD30C\uD5E4\uCE69\uB2C8\uB2E4. \uCDA9\uB0A8 \uAE08\uC0B0\uC758 \uBCF8\uC0B0\uC5D0\uC11C\uBD80\uD130 \uBA85\uB3D9\uC804\uB3C4\uB2E8\uC758 \uAE38\uAC70\uB9AC \uCE90\uC2A4\uD305, \uADF8\uB9AC\uACE0 \uC11C\uC6B8\uB300\uC640 \uC774\uD654\uC5EC\uB300 \uB4F1 \uBA85\uBB38\uB300\uB85C \uC2A4\uBA70\uB4E0 \uC704\uC7A5 \uB3D9\uC544\uB9AC\uC758 \uC18C\uB984 \uB3CB\uB294 \uAC00\uC2A4\uB77C\uC774\uD305 \uC218\uBC95\uC744 \uD3ED\uB85C\uD569\uB2C8\uB2E4. \uAC74\uAC15\uAC80\uC9C4\uC744 \uD551\uACC4 \uC0BC\uC740 \uCD94\uD589\uC744 \uCEE4\uD2BC\uC73C\uB85C \uAC00\uB824\uC900 \uC758\uC0AC\uB4E4, \uCE5C\uB538\uC744 \uBC14\uCE5C \uBD80\uBAA8\uC758 \uBE44\uADF9, \uADF8\uB9AC\uACE0 \uD604\uAE08 \uC721\uC5B5 \uC6D0\uC73C\uB85C \uC785\uC744 \uB9C9\uACE0 \uC5FC\uC0B0 \uD14C\uB7EC\uB97C \uC6B4\uC6B4\uD55C \uC870\uC9C1\uC801 \uC740\uD3D0 \uACF5\uC791\uAE4C\uC9C0 \uB2E4\uB8F9\uB2C8\uB2E4. \uAD6D\uC815\uC6D0 \uC9C1\uC6D0\uACFC \uD604\uC9C1 \uAC80\uC0AC, \uACBD\uCC30\uB9C8\uC800 \uC870\uB825\uC790\uB85C \uB098\uC130\uB358 \uC774 \uAC70\uB300\uD55C \uC545\uC758 \uAD74\uB808\uB97C \uB04A\uAE30 \uC704\uD574 \uC6B0\uB9AC \uBD80\uBAA8 \uC138\uB300\uAC00 \uBC18\uB4DC\uC2DC \uC54C\uC544\uC57C \uD560 \uBD84\uB178\uC758 \uD329\uD2B8\uCCB4\uD06C \uB9AC\uD3EC\uD2B8\uC785\uB2C8\uB2E4.\n\n\n#\uC815\uBA85\uC11D #\uC81C\uC774\uC5E0\uC5D0\uC2A4 #\uC0AC\uC774\uBE44\uC885\uAD50 #\uC704\uC7A5\uB3D9\uC544\uB9AC #\uAD8C\uB825\uC720\uCC29 #\uAC00\uC2A4\uB77C\uC774\uD305 #\uBA85\uB3D9\uC804\uB3C4\uB2E8 #\uC2E0\uC559\uC2A4\uD0C0 #\uD329\uD2B8\uCCB4\uD06C #\uCA50\uC2EC\n\n\uD83E\uDD16 \uC0AC\uD68C\uC801 \uC774\uC288 \uB0B4\uC9C0 \uACBD\uC81C \uC815\uBCF4\uB97C \uBCF4\uB2E4 \uBA85\uD655\uD558\uAC8C \uC804\uB2EC\uD558\uAE30 \uC704\uD574 \n\uC601\uC0C1 \uC81C\uC791 \uACFC\uC815\uC5D0\uC11C AI \uAE30\uC220(\uC74C\uC131 \uBC0F \uC2DC\uAC01 \uC790\uB8CC)\uC744 \uD65C\uC6A9\uD558\uC600\uC2B5\uB2C8\uB2E4.",
      "release": "2026-07-25T07:30:38Z",
      "duration": "00:16:58",
